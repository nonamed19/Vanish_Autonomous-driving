# ===== GOAL =====
# 호출 or 주차
string mode                        # "call" 또는 "park"

# 목표 위치 (lat, lon → x, y 변환된 PoseStamped)
geometry_msgs/PoseStamped target_pose

# 호출 시 원하는 도착 시간 (주차일 경우 무시됨)
time expected_arrival_time


---
# ===== RESULT =====
bool success                      # 동작 성공 여부
string message                    # 성공/실패에 대한 메시지


---
# ===== FEEDBACK =====
string status                     # 현재 상태 예: "moving", "arrived", "parking", etc.
