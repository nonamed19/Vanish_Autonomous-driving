pipeline {
    agent any

    environment {
        REGISTRY = 'taemin0323'
        CREDENTIALS_ID = 'Docker-Hub'
        SERVICE_NAME = 'remote-service'
        SERVICE_PORT = '8085'
        NETWORK_NAME = 'vanish-net'
        TARGET_DIR = 'BE/remote-service'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Git 소스코드 체크아웃 완료'
                script {
                    // Shallow clone 상태라면 전체 이력을 가져오도록 처리
                    def isShallow = sh(
                            script: 'git rev-parse --is-shallow-repository',
                            returnStdout: true
                    ).trim()

                    if (isShallow == 'true') {
                        echo "🔄 shallow clone 감지 → git fetch --unshallow 수행"
                        sh 'git fetch --unshallow'
                    } else {
                        echo "✅ 이미 full clone 상태입니다"
                    }

                    withCredentials([string(credentialsId: 'gitlab-jenkins-token', variable: 'GIT_TOKEN')]) {
                        sh '''
                            git remote set-url origin https://git:$GIT_TOKEN@lab.ssafy.com/s12-mobility-autodriving-sub1/S12P21A707.git
                            git fetch origin develop-BE
                        '''
                    }
                }
            }
        }

        stage('Check Directory Changes') {
            steps {
                script {
                    def diffFiles = sh(script: "git diff --name-only HEAD~1 HEAD", returnStdout: true).trim()
                    echo "변경된 파일 목록:\n${diffFiles}"

                    def hasChanges = diffFiles.tokenize('\n').any { file -> file.startsWith("${TARGET_DIR}/") }
                    def isManual = currentBuild.rawBuild.getCause(hudson.model.Cause$UserIdCause) != null

                    if (!hasChanges && !isManual) {
                        echo "${TARGET_DIR} 변경 없음. 자동 빌드 중단."
                        currentBuild.result = 'NOT_BUILT'
                        error("No relevant changes. Skipping build.")
                    } else if (hasChanges) {
                        echo "변경 감지됨. 빌드 계속 진행."
                    } else {
                        echo "수동 실행으로 계속 진행."
                    }
                }
            }
        }

        stage('Copy application.yml') {
            steps {
                 withCredentials([file(credentialsId: 'remote-service-application', variable: 'application')]) {
                    script {
                        dir("${TARGET_DIR}/src/main/resources") {
                            sh 'rm -f application.yml || true'
                            sh 'cp $application application.yml'
                            sh 'chmod 644 application.yml'
                        }
                    }
                }
            }
        }

        stage('Copy secretFiles') {
            steps {
                withCredentials([file(credentialsId: 'remote-public-key', variable: 'PUBLIC_KEY')]) {
                    script {
                        dir("${TARGET_DIR}/src/main/resources") {
                            sh 'cp $PUBLIC_KEY public_key.pem'
                            sh 'chmod 644 public_key.pem'
                        }
                    }
                }
            }
        }

        stage('Build with Gradle') {
            steps {
                dir("${TARGET_DIR}") {
                    sh 'chmod +x ./gradlew'
                    sh './gradlew clean build -x test'
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    def commitHash = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    env.IMAGE_TAG = commitHash

                    dir("${TARGET_DIR}") {
                        docker.withRegistry('https://index.docker.io/v1/', CREDENTIALS_ID) {
                            def image = docker.build("${REGISTRY}/${SERVICE_NAME}:${commitHash}")
                            image.push("${commitHash}")
                            image.push("latest")
                        }
                    }
                }
            }
        }

        stage('Docker Deploy') {
            steps {
                script {
                    sh "docker stop ${SERVICE_NAME} || true"
                    sh "docker rm ${SERVICE_NAME} || true"
                    sh "docker pull ${REGISTRY}/${SERVICE_NAME}:${IMAGE_TAG}"
                    sh "docker run -d --name ${SERVICE_NAME} --network ${NETWORK_NAME} -p ${SERVICE_PORT}:${SERVICE_PORT} ${REGISTRY}/${SERVICE_NAME}:${IMAGE_TAG}"
                    echo "${SERVICE_NAME} 배포 완료 (버전: ${IMAGE_TAG})"
                }
            }
        }
    }
}
